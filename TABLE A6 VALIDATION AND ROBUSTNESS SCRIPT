# ==============================================================================
# VALIDATION & ROBUSTNESS SCRIPT (FIXED: ISOLATED SAMPLES & PANEL LAGS)
# ==============================================================================
library(plm)
library(eurostat)
library(dplyr)
library(stargazer)

cat("\n========================================================\n")
cat("  1. LOAD CUSTOM PANEL & RUN BASELINE MODELS (Columns 1 & 3)\n")
cat("========================================================\n")

# 1. Φόρτωσε το δικό σου Dataset (χωρίς την Eurostat ακόμα)
raw_data <- read.csv2("Thesis_Final_Panel_Dataset_Bulletproof.csv", stringsAsFactors = FALSE)

numeric_cols <- c("Gini", "S8020", "LoneP", "LWI", "Unemp", "Tert", "House", "Heat", "Pens", "SocBen")
for(col in numeric_cols) {
  if(is.character(raw_data[[col]])) raw_data[[col]] <- as.numeric(gsub(",", ".", raw_data[[col]]))
}

# Μετατροπή σε pdata.frame για τα Baseline (Κρατάει όλες τις 589 παρατηρήσεις)
pdata_base <- pdata.frame(raw_data, index = c("Country", "Year"))

# Δημιουργία lags (χρησιμοποιώντας τη plm::lag για απόλυτη ασφάλεια στα όρια των χωρών)
pdata_base$Lag_House_Custom <- plm::lag(pdata_base$House, 1)
pdata_base$Lag_Unemp        <- plm::lag(pdata_base$Unemp, 1)
pdata_base$Lag_SocBen       <- plm::lag(pdata_base$SocBen, 1)
pdata_base$Lag_Pens         <- plm::lag(pdata_base$Pens, 1)
pdata_base$Lag_Tert         <- plm::lag(pdata_base$Tert, 1)
pdata_base$Lag_LoneP        <- plm::lag(pdata_base$LoneP, 1)
pdata_base$Lag_Heat         <- plm::lag(pdata_base$Heat, 1)
pdata_base$Lag_LWI          <- plm::lag(pdata_base$LWI, 1)

f_gini_base  <- Gini ~ Lag_House_Custom + Lag_Unemp + Lag_SocBen + Lag_Pens + Lag_Tert + Lag_LoneP + Lag_Heat + Lag_LWI
f_s8020_base <- S8020 ~ Lag_House_Custom + Lag_Unemp + Lag_SocBen + Lag_Pens + Lag_Tert + Lag_LoneP + Lag_Heat + Lag_LWI

# Τρέχουμε τα baseline μοντέλα
m_gini_base  <- plm(f_gini_base, data = pdata_base, model = "within", effect = "individual")
m_s8020_base <- plm(f_s8020_base, data = pdata_base, model = "within", effect = "individual")

cat("\n========================================================\n")
cat("  2. FETCH EUROSTAT DATA & RUN ROBUSTNESS MODELS (Columns 2 & 4)\n")
cat("========================================================\n")

# Συναρτηση καθαρισμού
clean_eurostat_data <- function(df, target_val_name, is_unemp = FALSE) {
  names(df) <- tolower(names(df))
  if("incgrp" %in% names(df)) df <- df %>% filter(toupper(incgrp) == "TOTAL")
  if("tenure" %in% names(df)) df <- df %>% filter(toupper(tenure) == "TOTAL")
  if("sex" %in% names(df)) df <- df %>% filter(toupper(sex) == "T")
  
  if(is_unemp) {
    if("age" %in% names(df)) df <- df %>% filter(toupper(age) == "Y15-74")
    if("unit" %in% names(df)) df <- df %>% filter(toupper(unit) == "PC_ACT")
  } else {
    if("age" %in% names(df)) df <- df %>% filter(toupper(age) == "TOTAL")
    if("unit" %in% names(df)) df <- df %>% filter(toupper(unit) == "PC")
  }
  
  if("time_period" %in% names(df)) df <- rename(df, Year = time_period)
  else if("time" %in% names(df)) df <- rename(df, Year = time)
  
  if("obs_value" %in% names(df)) df <- rename(df, !!target_val_name := obs_value)
  else if("values" %in% names(df)) df <- rename(df, !!target_val_name := values)
  
  if("geo" %in% names(df)) df <- rename(df, Country = geo)
  
  df %>% 
    select(Country, Year, all_of(target_val_name)) %>%
    distinct(Country, Year, .keep_all = TRUE)
}

# Download & Clean
house_euro <- clean_eurostat_data(get_eurostat("ilc_lvho07a", time_format = "num"), "House_Eurostat", is_unemp = FALSE)
unemp_euro <- clean_eurostat_data(get_eurostat("une_rt_a", time_format = "num"), "Unemp_Eurostat", is_unemp = TRUE)

# Merge μόνο για τα Robustness μοντέλα
val_data <- raw_data %>%
  left_join(house_euro, by = c("Country", "Year")) %>%
  left_join(unemp_euro, by = c("Country", "Year"))

pdata_euro <- pdata.frame(val_data, index = c("Country", "Year"))

# Lags για τα Eurostat μοντέλα (τα ξαναφτιάχνουμε στο νέο dataframe)
pdata_euro$Lag_House_Eurostat <- plm::lag(pdata_euro$House_Eurostat, 1)
pdata_euro$Lag_Unemp          <- plm::lag(pdata_euro$Unemp, 1)
pdata_euro$Lag_SocBen         <- plm::lag(pdata_euro$SocBen, 1)
pdata_euro$Lag_Pens           <- plm::lag(pdata_euro$Pens, 1)
pdata_euro$Lag_Tert           <- plm::lag(pdata_euro$Tert, 1)
pdata_euro$Lag_LoneP          <- plm::lag(pdata_euro$LoneP, 1)
pdata_euro$Lag_Heat           <- plm::lag(pdata_euro$Heat, 1)
pdata_euro$Lag_LWI            <- plm::lag(pdata_euro$LWI, 1)

f_gini_euro  <- Gini ~ Lag_House_Eurostat + Lag_Unemp + Lag_SocBen + Lag_Pens + Lag_Tert + Lag_LoneP + Lag_Heat + Lag_LWI
f_s8020_euro <- S8020 ~ Lag_House_Eurostat + Lag_Unemp + Lag_SocBen + Lag_Pens + Lag_Tert + Lag_LoneP + Lag_Heat + Lag_LWI

# Τρέχουμε τα Eurostat μοντέλα
m_gini_euro  <- plm(f_gini_euro, data = pdata_euro, model = "within", effect = "individual")
m_s8020_euro <- plm(f_s8020_euro, data = pdata_euro, model = "within", effect = "individual")

cat("\n========================================================\n")
cat("  3. CALCULATE STANDARD ERRORS & EXPORT TO WORD\n")
cat("========================================================\n")

# Arellano Standard Errors (HC0 group clustering)
se_g_base <- as.numeric(sqrt(diag(vcovHC(m_gini_base, type="HC0", cluster="group"))))
se_g_euro <- as.numeric(sqrt(diag(vcovHC(m_gini_euro, type="HC0", cluster="group"))))
se_s_base <- as.numeric(sqrt(diag(vcovHC(m_s8020_base, type="HC0", cluster="group"))))
se_s_euro <- as.numeric(sqrt(diag(vcovHC(m_s8020_euro, type="HC0", cluster="group"))))

# Εξαγωγή πίνακα
stargazer(m_s8020_base, m_s8020_euro, m_gini_base, m_gini_euro,
          type = "html",
          out = "TableA6_Housing_Robustness.doc",
          title = "Table A6: Robustness Check – Baseline vs. Official Eurostat Housing Cost Overburden",
          column.labels = c("S80/S20", "S80/S20", "Gini", "Gini"),
          dep.var.labels.include = FALSE,
          se = list(se_s_base, se_s_euro, se_g_base, se_g_euro),
          covariate.labels = c("Housing Cost (Custom, t-1)", "Housing Cost (Eurostat, t-1)", 
                               "Unemployment (t-1)", "Social Benefits (t-1)", "Pensions (t-1)", 
                               "Tertiary Edu. (t-1)", "Lone Parent (t-1)", 
                               "Heating Depr. (t-1)", "Low Work Int. (t-1)"),
          omit.stat = c("f", "ser", "adj.rsq", "wald"),
          notes = c("Notes: Country fixed effects with Arellano-clustered standard errors.",
                    "Columns (1) and (3) reproduce the baseline estimates.",
                    "Columns (2) and (4) substitute the regressor with the Eurostat series (ilc_lvho07a).",
                    "* p < 0.10, ** p < 0.05, *** p < 0.01."),
          notes.append = FALSE)

cat("\nSUCCESS: 'TableA6_Housing_Robustness.doc' created with correct separated samples!\n")
