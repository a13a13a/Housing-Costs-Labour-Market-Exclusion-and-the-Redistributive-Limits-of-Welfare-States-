# ========================================================
# DIAGNOSTIC TESTS: ROBUST HAUSMAN TEST & MULTICOLLINEARITY (VIF)
# ========================================================

library(plm)
library(lmtest)
library(car)

cat("========================================================\n")
cat("      HAUSMAN TESTS (Fixed vs. Random Effects)\n")
cat("========================================================\n")

# ========================================================
# ROBUST HAUSMAN TEST: FE vs. RE
# Uses the same one-year lagged specification as baseline Table 2
# ========================================================

# 1. Compute one-year lagged explanatory variables directly in pdata
pdata$House_l1  <- plm::lag(pdata$House, 1)
pdata$Unemp_l1  <- plm::lag(pdata$Unemp, 1)
pdata$SocBen_l1 <- plm::lag(pdata$SocBen, 1)
pdata$Pens_l1   <- plm::lag(pdata$Pens, 1)
pdata$Tert_l1   <- plm::lag(pdata$Tert, 1)
pdata$LoneP_l1  <- plm::lag(pdata$LoneP, 1)
pdata$Heat_l1   <- plm::lag(pdata$Heat, 1)
pdata$LWI_l1    <- plm::lag(pdata$LWI, 1)

# 2. Define clean model formulas without inline lag() calls
forms <- list(
  Gini = Gini ~ House_l1 + Unemp_l1 + SocBen_l1 + Pens_l1 + 
    Tert_l1 + LoneP_l1 + Heat_l1 + LWI_l1,
  
  S8020 = S8020 ~ House_l1 + Unemp_l1 + SocBen_l1 + Pens_l1 + 
    Tert_l1 + LoneP_l1 + Heat_l1 + LWI_l1
)

# 3. Execute regression-based robust Hausman tests (Arellano HC1 cluster-robust vcov)
for (nm in names(forms)) {
  
  ht <- phtest(
    forms[[nm]],
    data = pdata,
    model = c("within", "random"),
    effect = "individual",
    method = "aux",
    vcov = function(x) {
      vcovHC(
        x,
        method = "arellano",
        type = "HC1",
        cluster = "group"
      )
    }
  )
  
  cat("\nDependent Variable:", nm, "\n")
  print(ht)
  
  if (!is.na(ht$p.value) && ht$p.value < 0.05) {
    cat("Conclusion: Reject RE. Evidence supports FE.\n")
  } else {
    cat("Conclusion: Do not reject RE consistency.\n")
  }
}

cat("\n========================================================\n")
cat("      VARIANCE INFLATION FACTOR (VIF) TEST\n")
cat("========================================================\n")

