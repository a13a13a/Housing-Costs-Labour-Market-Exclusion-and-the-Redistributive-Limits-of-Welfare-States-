# ==============================================================================
# DIAGNOSTICS SCRIPT: Hausman Test (FE vs RE) and VIF (Multicollinearity)
# ==============================================================================

library(plm)
library(car) # Required for VIF function

# 1. Load the bulletproof dataset
raw_data <- read.csv2("Thesis_Final_Panel_Dataset_Bulletproof.csv", stringsAsFactors = FALSE)

# 2. Convert numeric columns (handling commas if necessary)
numeric_cols <- c("MedInc", "ARPT", "ARPR", "Gini", "S8020", "LoneP", "LWI", "Unemp", "Tert", "House", "Heat", "Pens", "SocBen")
for(col in numeric_cols) {
  if(is.character(raw_data[[col]])) {
    raw_data[[col]] <- as.numeric(gsub(",", ".", raw_data[[col]]))
  }
}

# 3. Create Panel Dataset
pdata <- pdata.frame(raw_data, index = c("Country", "Year"))

# 4. Define Variables
dep_vars <- c("Gini", "S8020")
indep_vars <- "House + Unemp + SocBen + Pens + Tert + LoneP + Heat + LWI"

cat("\n========================================================\n")
cat("      HAUSMAN TESTS (Fixed vs Random Effects)\n")
cat("========================================================\n")


# ========================================================
# ROBUST HAUSMAN TEST: FE vs RE
# Same lagged specification as baseline Table 2
# ========================================================

# ========================================================
# ROBUST HAUSMAN TEST: FE vs RE
# ========================================================
library(plm)
library(lmtest)

# 1. Υπολογισμός των lagged μεταβλητών ΚΑΤΕΥΘΕΙΑΝ στο pdata
pdata$House_l1  <- plm::lag(pdata$House, 1)
pdata$Unemp_l1  <- plm::lag(pdata$Unemp, 1)
pdata$SocBen_l1 <- plm::lag(pdata$SocBen, 1)
pdata$Pens_l1   <- plm::lag(pdata$Pens, 1)
pdata$Tert_l1   <- plm::lag(pdata$Tert, 1)
pdata$LoneP_l1  <- plm::lag(pdata$LoneP, 1)
pdata$Heat_l1   <- plm::lag(pdata$Heat, 1)
pdata$LWI_l1    <- plm::lag(pdata$LWI, 1)

# 2. Καθαρές φόρμουλες χωρίς τη συνάρτηση lag() εσωτερικά
forms <- list(
  Gini = Gini ~ House_l1 + Unemp_l1 + SocBen_l1 + Pens_l1 + 
    Tert_l1 + LoneP_l1 + Heat_l1 + LWI_l1,
  
  S8020 = S8020 ~ House_l1 + Unemp_l1 + SocBen_l1 + Pens_l1 + 
    Tert_l1 + LoneP_l1 + Heat_l1 + LWI_l1
)

# 3. Εκτέλεση του Robust Hausman Test
for (nm in names(forms)) {
  
  ht <- phtest(
    forms[[nm]],
    data = pdata,
    model = c("within", "random"),
    effect = "individual",
    method = "aux",
    vcov = function(x) {
      vcovHC(
        x,
        method = "arellano",
        type = "HC1",
        cluster = "group"
      )
    }
  )
  
  cat("\nDependent Variable:", nm, "\n")
  print(ht)
  
  if (!is.na(ht$p.value) && ht$p.value < 0.05) {
    cat("Conclusion: Reject RE. Evidence supports FE.\n")
  } else {
    cat("Conclusion: Do not reject RE consistency.\n")
  }
}

cat("\n========================================================\n")

# ========================================================
# VIF TEST FOR MULTICOLLINEARITY
# ========================================================
cat("      VARIANCE INFLATION FACTOR (VIF) TEST\n")
cat("========================================================\n")

# ========================================================
# VIF: LAGGED VARIABLES + COUNTRY FIXED EFFECTS
# ========================================================
cat("      VARIANCE INFLATION FACTOR (VIF) TEST\n")
cat("========================================================\n")

# We run a standard linear model on the pooled data to check VIF
vif_model <- lm(as.formula(paste("Gini ~", indep_vars)), data = pdata)
vif_results <- vif(vif_model)

print(vif_results)
cat("\nCONCLUSION: Max VIF is", max(vif_results), "which is strictly < 5. Severe multicollinearity is formally ruled out.\n")
cat("========================================================\n")
