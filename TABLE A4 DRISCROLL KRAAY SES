# ==============================================================================
# SENSITIVITY ANALYSIS SCRIPT: Table A4 (Driscoll-Kraay SEs: maxlag = 1 & 3)
# ==============================================================================

library(plm)
library(lmtest)
library(sandwich)
library(stargazer)

cat("\n========================================================\n")
cat("  1. LOAD DATA\n")
cat("========================================================\n")
# Use full path locally on your PC; keep relative path for GitHub repository
raw_data <- read.csv2("Thesis_Final_Panel_Dataset_Bulletproof.csv", stringsAsFactors = FALSE)

numeric_cols <- c("MedInc", "ARPT", "ARPR", "Gini", "S8020", "LoneP", "LWI", "Unemp", "Tert", "House", "Heat", "Pens", "SocBen")
for(col in numeric_cols) {
  if(is.character(raw_data[[col]])) {
    raw_data[[col]] <- as.numeric(gsub(",", ".", raw_data[[col]]))
  }
}

pdata <- pdata.frame(raw_data, index = c("Country", "Year"))

cat("\n========================================================\n")
cat("  2. ESTIMATE TWO-WAY FIXED EFFECTS MODELS\n")
cat("========================================================\n")
twfe_s8020 <- plm(S8020 ~ lag(House, 1) + lag(Unemp, 1) + lag(SocBen, 1) + lag(Pens, 1) + 
                    lag(Tert, 1) + lag(LoneP, 1) + lag(Heat, 1) + lag(LWI, 1), 
                  data = pdata, model = "within", effect = "twoways")

twfe_gini <- plm(Gini ~ lag(House, 1) + lag(Unemp, 1) + lag(SocBen, 1) + lag(Pens, 1) + 
                   lag(Tert, 1) + lag(LoneP, 1) + lag(Heat, 1) + lag(LWI, 1), 
                 data = pdata, model = "within", effect = "twoways")

cat("\n========================================================\n")
cat("  3. COMPUTE DRISCOLL-KRAAY SEs (maxlag = 1 and maxlag = 3)\n")
cat("========================================================\n")
dk_s8020_lag1 <- coeftest(twfe_s8020, vcov. = function(x) vcovSCC(x, type = "HC3", maxlag = 1))
dk_s8020_lag3 <- coeftest(twfe_s8020, vcov. = function(x) vcovSCC(x, type = "HC3", maxlag = 3))

dk_gini_lag1  <- coeftest(twfe_gini, vcov. = function(x) vcovSCC(x, type = "HC3", maxlag = 1))
dk_gini_lag3  <- coeftest(twfe_gini, vcov. = function(x) vcovSCC(x, type = "HC3", maxlag = 3))

cat("\n========================================================\n")
cat("  4. EXPORT TABLE A4 TO WORD (.doc)\n")
cat("========================================================\n")
out_tableA4_file <- "TableA4_Sensitivity_DK_Lags.doc"

stargazer(twfe_s8020, twfe_s8020, twfe_gini, twfe_gini,
          type = "html",
          out = out_tableA4_file,
          title = "Table A4: Sensitivity Analysis – Two-Way Fixed Effects with Alternative Driscoll-Kraay Bandwidths (maxlag = 1 and 3)",
          column.labels = c("S80/S20 Ratio", "Gini Coefficient"),
          column.separate = c(2, 2),
          dep.var.labels.include = FALSE,
          se = list(dk_s8020_lag1[,2], dk_s8020_lag3[,2], dk_gini_lag1[,2], dk_gini_lag3[,2]),
          p  = list(dk_s8020_lag1[,4], dk_s8020_lag3[,4], dk_gini_lag1[,4], dk_gini_lag3[,4]),
          covariate.labels = c("Housing Cost (t-1)", "Unemployment (t-1)", 
                               "Social Benefits (t-1)", "Pensions (t-1)", 
                               "Tertiary Edu. (t-1)", "Lone Parent (t-1)", 
                               "Heating Depr. (t-1)", "Low Work Int. (t-1)"),
          add.lines = list(c("Driscoll-Kraay Max Lag", "1", "3", "1", "3")),
          omit.stat = c("f", "ser"),
          notes = c("Notes: All models include country and year fixed effects. Point estimates are identical across lag bandwidths by construction.",
                    "Driscoll-Kraay standard errors with maximum lags of 1 (columns 1 and 3) and 3 (columns 2 and 4) are reported in parentheses.",
                    "* p < 0.10, ** p < 0.05, *** p < 0.01."),
          notes.append = FALSE)

cat("\n--------------------------------------------------------\n")
cat(" SUCCESS: Table A4 exported to:", out_tableA4_file, "\n")
cat("--------------------------------------------------------\n")
